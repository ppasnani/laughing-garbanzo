{
  "paper_id": "W3197485759",
  "paper_title": "WaFFLe: Gated Cache-Ways with Per-Core Fine-Grained DVFS for Reduced On-Chip Temperature and Leakage Consumption",
  "artifact_search_status": "checked_no_links",
  "linked_assets": [],
  "scenario": {
    "pdf_page": 12,
    "figure_or_table": "Table 1. System parameters and Figure 13-14. Simulation framework (16-core tiled CMP)",
    "description": "WaFFLe evaluation on 16-core homogeneous tiled CMP with Alpha 21364 OoO cores, private L1 caches, physically distributed L2 (1MB, 16-way, 12-cycle latency), 2D-mesh NoC. PARSEC multi-threaded benchmark suite with 16 threads, large input sets, RoI simulation. Temperature traces via integrated gem5, McPAT (32nm, dynamic power), HotSpot 6.0 (leakage power with component-wise temperature feedback). 0.33 μs periodic interval for thermal stability assumption. Baseline config: 1.12V/3.0GHz max, 0.76V/1.2GHz min, 70ns uniform DRAM latency, 47°C ambient.",
    "architecture": "16-tile homogeneous CMP, Alpha 21364 OoO cores, 64KB L1-I (4-way), 64KB L1-D (4-way, 3 cycles, 8 MSHRs), 1MB shared L2 (16-way, SNUCA, LRU, 64B blocks), 2D-mesh NoC with per-tile router, on-chip voltage regulators (20 mV/ns switching speed), 32nm technology",
    "workload": "PARSEC benchmark suite (multi-threaded, 16 threads per application, large input sets): Black, Body, Can, Ded, Fluid, Freq, Stream, Swap, X264. Region of Interest (RoI) execution traces collected over 80M cycles.",
    "operating_point": "Maximum frequency/voltage: 1.12V at 3.0GHz; Reduced frequency/voltage for FG-DVFS: 0.76V at 1.2GHz. Way-shutdown thresholds: POWER_DOWN=0.025 (miss ratio <2.5%), POWER_UP=0.04 (miss ratio >4%), Interval=2M clock cycles. Cache-way resizing: up to 8 ways can be gated. FG-DVFS applied during global isolated LLC misses with ~70ns off-chip access latency.",
    "steady_2d_relevant": true
  },
  "original_setup": {
    "solver": "gem5 full-system simulator with Ruby cache model",
    "optimizer": "Algorithm 1 (way-shutdown miss-ratio thresholds: POWER_DOWN=0.025, POWER_UP=0.04, Interval=2M cycles) and Algorithm 2 (FG-DVFS counter-based period control)",
    "controller": "LLC controller (way-shutdown logic via performance monitoring counters), per-core FG-DVFS controller (detects global isolated LLC misses via directory entries, activates voltage regulator)",
    "benchmark": "PARSEC benchmark suite (9 applications: Black, Body, Can, Ded, Fluid, Freq, Stream, Swap, X264) with 16 threads, large input sets, RoI portion execution"
  },
  "thermal_observable": {
    "value": 8.4,
    "unit": "°C",
    "location": "peak temperature across 16-core homogeneous CMP",
    "aggregation": "maximum reduction from baseline (WaFFLe applied)",
    "pdf_page": 2
  },
  "physical_mismatches": [
    {
      "reason": "Uniform 70ns DRAM latency assumption simplifies off-chip access time prediction; real systems have variable memory access patterns",
      "essential": false
    },
    {
      "reason": "On-chip voltage regulators (20 mV/ns switching) assumed with negligible overhead; actual power consumption and thermal effects of regulators not fully modeled in component-wise temperature feedback",
      "essential": false
    },
    {
      "reason": "32nm technology node; modern CMPs use 7nm or smaller, affecting power density and thermal behavior scaling",
      "essential": false
    },
    {
      "reason": "2D-mesh NoC with 1-cycle per-tile propagation delay; assumes uniform tiled layout without accounting for 3D stacking, interposer cooling, or heterogeneous core placement",
      "essential": false
    },
    {
      "reason": "Periodic 0.33 μs thermal stability interval assumption may not hold for transient thermal events or rapid workload phase changes",
      "essential": false
    }
  ],
  "studio_assumptions": [
    "WaFFLe implementation in gem5 Ruby module with performance monitoring counters (no additional hardware cost for way-shutdown)",
    "McPAT power model assumes uniform on-chip temperature for leakage; paper compensates with component-wise temperature from HotSpot at end of each period",
    "HotSpot 6.0 steady-state thermal model used; no transient thermal solver or 3D heat dissipation simulation",
    "Way-shutdown algorithm assumes clean non-MRU (CN) blocks are invalidatable without live-data loss; preliminary analysis on 9 PARSEC apps showed <2% cache sets with all-dirty blocks",
    "FG-DVFS assumes on-chip voltage regulators present; coherence directory exploited for global isolated miss detection",
    "All 16 cores always active (maximum workload assumption); no idle or power-gating states beyond cache-way shutdown",
    "DVFS applied only at two V/F settings (1.12V/3.0GHz and 0.76V/1.2GHz); no intermediate frequency scaling",
    "Intra-set cache block migration via temporary buffer preferred over off-chip writeback based on analytical cost comparison (equations 1–2)",
    "PARSEC large input sets with 16 threads; one thread per core; no SMT or dynamic thread mapping"
  ],
  "missing_inputs": [
