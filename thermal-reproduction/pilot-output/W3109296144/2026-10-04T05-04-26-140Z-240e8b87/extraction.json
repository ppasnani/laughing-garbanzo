  "scenario": {
    "pdf_page": 8,
    "figure_or_table": "Section 4.1 Experimental Setup, Table 2",
    "description": "64-core NoC-based many-core system with 32 active cores and 32 dark cores arranged in chessboard pattern, running mixed SPLASH2/PARSEC workloads (Radix, Ocean, Blackscholes, Bodytrack) at threshold temperatures 60-85°C",
    "architecture": "64-core homogeneous ISA with heterogeneous frequency, 8x8 mesh NoC, private L1-I/L1-D caches (32KB each), private L2 cache (512KB per core), shared L3 cache (8MB per 8-core cluster), 22nm technology",
    "workload": "Mix of compute-intensive (Radix, Blackscholes) and memory-intensive (Ocean, Bodytrack) applications from SPLASH2 and PARSEC benchmark suites, each with 8 threads",
    "operating_point": "Maximum frequency 4GHz, threshold temperatures ranging 60-85°C, chessboard active/dark core pattern, DVFS frequency step 200MHz, safe margin 5°C, TDP constraint 42W for OSP comparison",
    "steady_2d_relevant": true
  },
  "original_setup": {
    "solver": "Sniper x86-64 multi-core simulator",
    "optimizer": "DTaPO algorithm with task migration and DVFS",
    "controller": "Dynamic thermal-aware controller managing task migration between active and dark cores within LLC clusters, with DVFS fallback",
    "benchmark": "Mix of SPLASH2 (Radix, Ocean) and PARSEC (Blackscholes, Bodytrack) benchmark applications, 8 threads each"
  },
  "thermal_observable": {
    "value": null,
    "unit": "°C",
    "location": "Per-core transient temperature across 64-core NoC system",
    "aggregation": "10th and 90th percentiles for minimum and maximum temperature; average temperature monitored per control period",
    "pdf_page": 13
  },
  "physical_mismatches": [
    {
      "reason": "Simulation-only study: No real hardware implementation or validation; Sniper reports ~25% average performance error versus real hardware",
      "essential": true
    },
    {
      "reason": "Simplified thermal modeling: HotSpot-based transient temperature using stacked-layer packaging model; actual chip heat dissipation and packaging details may differ from real hardware (see Figure 6, page 10)",
      "essential": false
    },
    {
      "reason": "Chessboard pattern enforces only 50% core activation; many-core systems may have different dark silicon constraints depending on power budget and thermal envelope",
      "essential": false
    },
    {
      "reason": "Wake-up latency modeled as fixed 100µs; real Intel Xeon Phi and other processors have variable latencies depending on C-state depth and silicon variations",
      "essential": false
    },
    {
      "reason": "Cold start penalty approximated as 1000 cycles for task migration state save/restore; actual overhead depends on memory subsystem and architecture details",
      "essential": false
    }
  ],
  "studio_assumptions": [
    "Homogeneous instruction set architecture (ISA) across all 64 cores with heterogeneous per-core frequency scaling capability",
    "Cluster-based task migration allowed only among cores sharing the same 8MB L3 cache (8 cores per cluster)",
    "Source core enters C1 low-power state (maintains L1/L2 cache contents) during initial task migration phase to reduce cold start cache miss penalty",
    "Destination dark core can access source core L2 cache during initial migration before transitioning to full activity",
    "Chessboard active/dark core spatial pattern provides optimal thermal dissipation with 1-hop communication latency penalty (~1% performance impact)",
    "L3 cache power excluded from thermal calculations as shared and located outside individual cores",
    "Control period-based monitoring: transient temperatures sampled periodically, with DTaPO decisions based on per-control-period temperature readings",
    "Safe margin ε set to 5°C to prevent oscillation between active and dark core modes",
    "Frequency scaling step (ζ) fixed at 200 MHz; frequency increased only if below threshold frequency (3.6 GHz) and temperature below threshold minus safe margin",
    "All task migrations occur within same LLC cluster; no cross-cluster migrations modeled",
    "No process variation, aging, or reliability constraints considered in thermal management decisions"
  ],
  "missing_inputs": [
    "No experimental data provided; simulation-based only with no real hardware measurements or silicon testchip results",
    "Repository URL or supplementary simulation code not provided; Sniper modifications for dark silicon modeling not publicly available",
    "Actual power profile validation data from McPAT for 22nm technology at different frequency/voltage points not included in paper",
    "Specific floorplan coordinates (x, y) for each core in the 64-core system not provided; only generic 8×8 mesh NoC described",
    "Thermal interface material properties (Table 4) assumed fixed; actual package variant and thermal interface thickness variations not modeled",
    "TDP constraint (42W) used only for OSP comparison; primary DTaPO experiments use threshold temperature constraint rather than power budget",
    "No sensitivity analysis provided for key parameters: safe margin ε, frequency step ζ, wake-up latency, or cold start penalty (1000 cycles)",
    "Comparison with only OSP algorithm from prior work; no comparison with other recent dark silicon thermal management techniques (DaSiM, Kanduri et al.) on same platform",
    "DVFS voltage levels and voltage-frequency relationship not specified; only frequency points reported",
    "No measurement of actual cache miss rates during task migration or validation that L2 cache data availability reduces cold start overhead as assumed"
  ],
